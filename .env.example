# ===================================================================
# ImobiFlow — variáveis de ambiente
# Copie para .env (local) ou configure no painel do host (produção).
# NUNCA commite o .env real. Este arquivo só contém placeholders.
# ===================================================================

# --- Supabase ---
# URL do projeto (não é segredo)
SUPABASE_URL="https://SEU-PROJETO.supabase.co"
# service_role key — SEGREDO. Acesso total ao banco (ignora RLS).
# Pegue em: Supabase > Project Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY="COLE_A_SERVICE_ROLE_KEY_AQUI"
# anon key — usada pelo frontend (pode ser pública)
VITE_SUPABASE_ANON_KEY="COLE_A_ANON_KEY_AQUI"

# --- App ---
# Origem pública única da aplicação (sem barra no final).
# Usada em links, redirects, cabeçalhos de IA e webhooks.
PUBLIC_APP_URL="https://seudominio.com"
# Em produção defina NODE_ENV=production (serve o build estático em vez do Vite dev)
NODE_ENV="production"

# --- Asaas (cobrança recorrente) ---
# Em produção: ASAAS_ENV=production e a API key de produção
ASAAS_API_KEY="COLE_A_API_KEY_DO_ASAAS_AQUI"
ASAAS_ENV="production"
# Valor mensal da assinatura em R$ (ex.: 49.90)
SUBSCRIPTION_VALUE="49.90"

# Operações financeiras dos clientes (aluguel e sinal de reserva).
# O produto atual é CRM operacional: mantenha ambas em false.
# A assinatura do próprio ImobiFlow continua usando ASAAS_API_KEY normalmente.
CLIENT_FINANCIAL_OPERATIONS_ENABLED="false"
VITE_CLIENT_FINANCIAL_OPERATIONS_ENABLED="false"

# --- UAZAPI (provider WhatsApp) ---
UAZAPI_HOST="https://criate.uazapi.com"
UAZAPI_TOKEN="COLE_O_TOKEN_UAZAPI_AQUI"
# Nome da instância/sessão UAZAPI para envios da plataforma (ex: recuperação de senha via WhatsApp)
UAZAPI_PLATFORM_SESSION="NOME_DA_SESSAO_PLATAFORMA"

# --- Webhooks N8N ---
# Webhook que o backend chama para processar mensagens recebidas no WhatsApp
N8N_WEBHOOK_URL="https://212hook.seudominio.com/webhook/SEU-ID-DE-TICKETS"

# --- IA / Proxy LLM (multi-tenant OpenRouter) ---
# Token interno: N8N usa este token para autenticar no proxy /api/proxy/llm
# Gere com: openssl rand -hex 24
INTERNAL_PROXY_TOKEN="GERE_COM_openssl_rand_-hex_24"
# Somente durante rotação sem downtime; remova após atualizar o n8n.
INTERNAL_PROXY_TOKEN_PREVIOUS=""
# Credencial dedicada enviada no header Authorization ao webhook do n8n.
# Configure o Webhook node com Header Auth antes de remover o fallback.
N8N_WEBHOOK_TOKEN="GERE_OUTRO_TOKEN_COM_openssl_rand_-hex_24"
# Chave AES-256 para criptografar segredos por corretor no banco (key OpenRouter
# e a chave de cobrança Asaas própria da imobiliária). Gere com: openssl rand -hex 32
LLM_PROXY_ENC_KEY="GERE_COM_openssl_rand_-hex_32"
# Chave da empresa no OpenRouter — fallback quando corretor não configurou a própria
OPENROUTER_API_KEY="sk-or-COLE_SUA_CHAVE_OPENROUTER_AQUI"
OPENROUTER_N8N_MODELS="openai/gpt-4o-mini,google/gemini-2.5-flash-lite"

# --- Fila duravel de webhooks (Postgres) ---
# Ajuste estes valores apenas depois de medir o fluxo real em teste de carga.
WEBHOOK_INBOX_BATCH_SIZE="10"
WEBHOOK_OUTBOX_BATCH_SIZE="20"
WEBHOOK_QUEUE_MAX_ATTEMPTS="20"
WEBHOOK_WORKER_POLL_MS="1000"
